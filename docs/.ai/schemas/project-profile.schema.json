{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-profile.schema.json",
  "title": "Project Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "owner",
    "workflow"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "project-profile/v1"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "summary"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_language",
        "report_language"
      ],
      "properties": {
        "repository_language": {
          "type": "string",
          "minLength": 1
        },
        "report_language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "toolchain": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "architecture_invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "canonical_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracking",
        "primary_orchestrator",
        "fallback_planners",
        "implementation_harnesses"
      ],
      "properties": {
        "tracking": {
          "const": "github_issues"
        },
        "primary_orchestrator": {
          "type": "string",
          "minLength": 1
        },
        "fallback_planners": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "implementation_harnesses": {
          "type": "array",
          "items": {
            "enum": [
              "codex",
              "claude_code"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
