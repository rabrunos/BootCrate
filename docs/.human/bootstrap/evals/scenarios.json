{
  "schema": "bootcrate-scenarios/v1",
  "scenarios": [
    {
      "id": "static-edit",
      "prompt": "Fix a known cursor rule in a local static page. The exact selector and a regression test are supplied; no external content, service or privilege changes.",
      "expected": {
        "main_effort": [
          "medium",
          "high"
        ],
        "local_discovery": [
          "none"
        ],
        "required_controls": [
          "scope-boundary",
          "regression-test"
        ],
        "forbidden_capabilities": [
          "database",
          "authentication",
          "self-hosting"
        ],
        "required_blocked_actions": [
          "publish"
        ]
      }
    },
    {
      "id": "saas-identity",
      "prompt": "Design an internet SaaS with login, multiple customers, private identity documents and hosted payments. No production account is authorized yet.",
      "expected": {
        "main_effort": [
          "xhigh"
        ],
        "local_discovery": [
          "none",
          "targeted"
        ],
        "required_modules": [
          "web-api",
          "infrastructure",
          "sensitive-data"
        ],
        "required_controls": [
          "tenant-isolation",
          "safe-uploads",
          "secret-isolation",
          "payment-tokenization",
          "independent-review"
        ],
        "required_blocked_actions": [
          "publish",
          "production-data"
        ]
      }
    },
