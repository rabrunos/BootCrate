{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bootcrate-project-intake.schema.json",
  "title": "BootCrate Project Intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "answers"
  ],
  "properties": {
    "schema": {
      "const": "bootcrate-project-intake/v1"
    },
    "exported_at": {
      "type": "string"
    },
    "session": {
      "type": "object",
      "additionalProperties": true
    },
    "language": {
      "enum": [
        "en",
        "pt-BR"
      ]
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_name": {
          "type": "string"
        },
        "one_sentence": {
          "type": "string"
        },
        "project_kind": {
          "type": "string",
          "enum": [
            "game",
            "game_mod",
            "game_engine",
            "web_app",
            "desktop_app",
            "mobile_app",
            "library",
            "cli_tool",
            "service",
            "automation",
            "other"
          ]
        },
        "existing_or_new": {
          "type": "string",
          "enum": [
            "new",
            "existing_code",
            "external_target",
            "unknown"
          ]
        },
        "success": {
          "type": "string"
        },
        "non_goals": {
          "type": "string"
        },
        "owner_role": {
          "type": "string"
        },
        "technical_level": {
          "type": "string",
          "enum": [
            "nontechnical",
            "beginner",
            "intermediate",
            "advanced",
            "expert"
          ]
        },
        "report_language": {
          "type": "string",
          "enum": [
            "pt-BR",
            "en",
            "other"
          ]
        },
        "repo_language": {
          "type": "string",
          "enum": [
            "en",
            "pt-BR",
            "other"
          ]
        },
        "autonomy": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "target_platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "windows",
              "linux",
              "macos",
              "web",
              "android",
              "ios",
              "console",
              "server",
              "unknown"
            ]
          },
          "uniqueItems": true
        },
        "primary_dev_os": {
          "type": "string",
          "enum": [
            "windows",
            "linux",
            "macos",
            "unknown"
          ]
