        "game_dimension": {
          "type": "string",
          "enum": [
            "2d",
            "3d",
            "hybrid",
            "unknown"
          ]
        },
        "multiplayer": {
          "type": "string",
          "enum": [
            "none",
            "local",
            "online",
            "maybe",
            "unknown"
          ]
