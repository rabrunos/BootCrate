        "save_system": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "web_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "frontend",
              "backend",
              "database",
              "auth",
              "realtime",
              "unknown"
            ]
          },
          "uniqueItems": true
        },
        "hosting_known": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "hosting_value": {
          "type": "string"
        },
        "sensitive_data": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "secrets_needed": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "log_privacy": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "compliance": {
          "type": "string"
        },
        "automated_tests": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "recommended",
            "unknown"
          ]
        },
        "manual_smoke": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "ci": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "recommended"
          ]
        },
        "validation_priorities": {
          "type": "string"
        },
