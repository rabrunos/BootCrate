        "local_large_data": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "logs",
              "binaries",
              "decompile",
              "screenshots",
              "datasets",
              "build_artifacts",
              "none",
              "unknown"
            ]
          },
          "uniqueItems": true
        },
        "diagnostic_reduction": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "recommend"
          ]
        },
        "must_have_tools": {
          "type": "string"
        },
        "must_avoid_tools": {
          "type": "string"
        },
        "known_risks": {
          "type": "string"
        },
        "research_requests": {
          "type": "string"
        },
        "anything_else": {
          "type": "string"
        }
      }
