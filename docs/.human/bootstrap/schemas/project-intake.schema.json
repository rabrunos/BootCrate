          "type": "string",
          "enum": [
            "single",
            "small_team",
            "team"
          ]
        },
        "issues_tracking": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "custom"
          ]
        },
        "commit_push_policy": {
          "type": "string",
          "enum": [
            "yes",
            "ask",
            "no"
          ]
        },
