        "offline_requirement": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "partial",
            "unknown"
          ]
        },
        "language_known": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "preference",
            "unknown"
          ]
        },
        "language_value": {
          "type": "string"
        },
        "framework_known": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "preference",
            "unknown"
          ]
        },
        "framework_value": {
          "type": "string"
        },
        "dependency_constraints": {
          "type": "string"
        },
        "performance_constraints": {
          "type": "string"
        },
        "external_product_name": {
          "type": "string"
        },
        "official_sdk_known": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
