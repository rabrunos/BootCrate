        "primary_orchestration": {
          "type": "string",
          "enum": [
            "chatgpt",
            "local_planner",
            "custom"
          ]
        },
        "claude_code": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "maybe"
          ]
        },
        "planning_fallback": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "codex_plan",
              "claude_plan",
              "none"
            ]
          },
          "uniqueItems": true
        },
        "codex_local": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "maybe"
          ]
        },
        "codex_cloud": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "maybe"
          ]
        },
        "agent_budget": {
